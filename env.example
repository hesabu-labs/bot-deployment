# Copy this file to .env and fill in real values.
# Never commit the real .env to git - add it to .gitignore.
# Load it with:  pip install python-dotenv
#   from dotenv import load_dotenv
#   load_dotenv()
# ...before the os.environ[...] lines run.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_API_KEY=your_gemini_api_key_here
ODDS_API_KEY=your_the_odds_api_key_here
# ^ used only for the free /events fixture list - no bookmaker odds pulled or used.

# Optional - caps Gemini search-grounded calls per chat per ISO week (default 60)
GEMINI_WEEKLY_QUOTA=60

# Only needed if you bring odds_ingestion.py back into the active pipeline:
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here
API_FOOTBALL_KEY=your_api_football_key_here
